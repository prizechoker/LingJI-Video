 "subtitles": [
  {
   "start": 0.19,
   "end": 5.168,
   "segs": [
    {
     "t": "能赢下围棋世界冠军的AI，却"
    },
    {
     "t": "拿不起一颗棋子",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 5.778,
   "end": 10.003,
   "segs": [
    {
     "t": "2016年，AlphaGo战胜李世石。"
    }
   ]
  },
  {
   "start": 10.013,
   "end": 11.795,
   "segs": [
    {
     "t": "很少有人注意到："
    }
   ]
  },
  {
   "start": 11.755,
   "end": 13.32,
   "segs": [
    {
     "t": "它的每一步棋，"
    }
   ]
  },
  {
   "start": 13.28,
   "end": 16.95,
   "segs": [
    {
     "t": "都是一位"
    },
    {
     "t": "工程师替它放到棋盘上",
     "c": "gold"
    },
    {
     "t": "的。"
    }
   ]
  },
  {
   "start": 17.46,
   "end": 19.025,
   "segs": [
    {
     "t": "十年后的今天，"
    }
   ]
  },
  {
   "start": 18.985,
   "end": 22.341,
   "segs": [
    {
     "t": "机器人已经能"
    },
    {
     "t": "翻跟头、跑半马",
     "c": "cyan"
    },
    {
     "t": "了。"
    }
   ]
  },
  {
   "start": 22.351,
   "end": 25.372,
   "segs": [
    {
     "t": "可它，还是"
    },
    {
     "t": "洗不好你家的碗",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 25.732,
   "end": 26.794,
   "segs": [
    {
     "t": "为什么？"
    }
   ]
  },
  {
   "start": 29.104,
   "end": 33.715,
   "segs": [
    {
     "t": "1979年，斯坦福有一辆装着摄像头的小车，"
    }
   ]
  },
  {
   "start": 33.675,
   "end": 36.693,
   "segs": [
    {
     "t": "要穿过一个摆满椅子的房间。"
    }
   ]
  },
  {
   "start": 36.953,
   "end": 38.785,
   "segs": [
    {
     "t": "它花了"
    },
    {
     "t": "五个小时",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 38.795,
   "end": 41.449,
   "segs": [
    {
     "t": "每走一米，就停下来拍照，"
    }
   ]
  },
  {
   "start": 41.409,
   "end": 43.123,
   "segs": [
    {
     "t": "再想十几分钟。"
    }
   ]
  },
  {
   "start": 43.633,
   "end": 46.77,
   "segs": [
    {
     "t": "带它上路的博士生叫莫拉维克。"
    }
   ]
  },
  {
   "start": 46.78,
   "end": 50.086,
   "segs": [
    {
     "t": "他后来总结：让电脑下棋并不难；"
    }
   ]
  },
  {
   "start": 50.046,
   "end": 52.48,
   "segs": [
    {
     "t": "难的是像"
    },
    {
     "t": "一岁小孩",
     "c": "cyan"
    },
    {
     "t": "那样，"
    }
   ]
  },
  {
   "start": 52.44,
   "end": 55.898,
   "segs": [
    {
     "t": "看一眼，走两步，伸手拿个东西",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 56.558,
   "end": 58.123,
   "segs": [
    {
     "t": "可既然这么难，"
    }
   ]
  },
  {
   "start": 58.083,
   "end": 62.843,
   "segs": [
    {
     "t": "工厂里的机器人，又是怎么干了"
    },
    {
     "t": "六十多年",
     "c": "gold"
    },
    {
     "t": "活的？"
    }
   ]
  },
  {
   "start": 63.253,
   "end": 68.566,
   "segs": [
    {
     "t": "1961年，第一台工业机器人在美国通用汽车上岗。"
    }
   ]
  },
  {
   "start": 68.576,
   "end": 71.597,
   "segs": [
    {
     "t": "它"
    },
    {
     "t": "没有眼睛",
     "c": "gold"
    },
    {
     "t": "，什么也看不见。"
    }
   ]
  },
  {
   "start": 71.907,
   "end": 74.558,
   "segs": [
    {
     "t": "但工厂替它安排好了一切："
    }
   ]
  },
  {
   "start": 74.518,
   "end": 76.52,
   "segs": [
    {
     "t": "每个零件，每一次，"
    }
   ]
  },
  {
   "start": 76.48,
   "end": 78.847,
   "segs": [
    {
     "t": "都出现在"
    },
    {
     "t": "同一个位置",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 79.107,
   "end": 80.286,
   "segs": [
    {
     "t": "它不用看。"
    }
   ]
  },
  {
   "start": 80.296,
   "end": 84.839,
   "segs": [
    {
     "t": "因为它面前的世界，已经被摆成了"
    },
    {
     "t": "一张棋盘",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 85.499,
   "end": 88.738,
   "segs": [
    {
     "t": "后来的成功，几乎都靠这一招。"
    }
   ]
  },
  {
   "start": 88.948,
   "end": 90.997,
   "segs": [
    {
     "t": "仓库机器人不认路？"
    }
   ]
  },
  {
   "start": 91.007,
   "end": 95.333,
   "segs": [
    {
     "t": "那就在地上"
    },
    {
     "t": "贴满二维码",
     "c": "gold"
    },
    {
     "t": "，让它在格子里走。"
    }
   ]
  },
  {
   "start": 95.543,
   "end": 98.027,
   "segs": [
    {
     "t": "扫地机器人干不了家务？"
    }
   ]
  },
  {
   "start": 98.037,
   "end": 101.058,
   "segs": [
    {
     "t": "那就只交给它一件事："
    },
    {
     "t": "地板",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 101.318,
   "end": 105.276,
   "segs": [
    {
     "t": "就连洗碗，我们也没造一个会洗碗的“人”，"
    }
   ]
  },
  {
   "start": 105.236,
   "end": 107.018,
   "segs": [
    {
     "t": "而是造了个"
    },
    {
     "t": "盒子",
     "c": "gold"
    },
    {
     "t": "："
    }
   ]
  },
  {
   "start": 106.978,
   "end": 109.784,
   "segs": [
    {
     "t": "碗插进格子，关门，喷水。"
    }
   ]
  },
  {
   "start": 110.394,
   "end": 113.483,
   "segs": [
    {
     "t": "所以，机器人六十多年的成功，"
    }
   ]
  },
  {
   "start": 113.443,
   "end": 116.094,
   "segs": [
    {
     "t": "靠的大多不是机器变聪明，"
    }
   ]
  },
  {
   "start": 116.054,
   "end": 119.076,
   "segs": [
    {
     "t": "而是"
    },
    {
     "t": "我们把世界，变简单了",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 120.086,
   "end": 124.182,
   "segs": [
    {
     "t": "可有一个地方，变不成棋盘——"
    },
    {
     "t": "你家",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 124.592,
   "end": 128.115,
   "segs": [
    {
     "t": "碗的形状各不一样，衣服随手一扔，"
    }
   ]
  },
  {
   "start": 128.075,
   "end": 129.907,
   "segs": [
    {
     "t": "猫还会跳上桌子。"
    }
   ]
  },
  {
   "start": 129.917,
   "end": 132.069,
   "segs": [
    {
     "t": "每一天，都不一样",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 132.579,
   "end": 136.102,
   "segs": [
    {
     "t": "于是，越来越多的人押注另一条路："
    }
   ]
  },
  {
   "start": 136.062,
   "end": 139.083,
   "segs": [
    {
     "t": "改不了世界，那就"
    },
    {
     "t": "改机器人",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 139.343,
   "end": 143.737,
   "segs": [
    {
     "t": "我们的世界，本来就是照着"
    },
    {
     "t": "人的身体",
     "c": "gold"
    },
    {
     "t": "设计的："
    }
   ]
  },
  {
   "start": 143.697,
   "end": 145.968,
   "segs": [
    {
     "t": "门把手、楼梯、锅铲。"
    }
   ]
  },
  {
   "start": 145.978,
   "end": 149.652,
   "segs": [
    {
     "t": "那干脆，把机器人也造成人的样子。"
    }
   ]
  },
  {
   "start": 150.062,
   "end": 152.933,
   "segs": [
    {
     "t": "你看，人形机器人上了春晚，"
    }
   ]
  },
  {
   "start": 152.893,
   "end": 157.219,
   "segs": [
    {
     "t": "还在半马比赛里，"
    },
    {
     "t": "跑赢了人类的世界纪录",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 157.579,
   "end": 161.317,
   "segs": [
    {
     "t": "可在赛道上把同一个动作重复几万次，"
    }
   ]
  },
  {
   "start": 161.277,
   "end": 164.363,
   "segs": [
    {
     "t": "和面对一摞每次都不一样的碗，"
    }
   ]
  },
  {
   "start": 164.323,
   "end": 165.603,
   "segs": [
    {
     "t": "是两回事",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 166.013,
   "end": 169.971,
   "segs": [
    {
     "t": "今天，有的家务机器人碰到复杂的活儿，"
    }
   ]
  },
  {
   "start": 169.931,
   "end": 173.669,
   "segs": [
    {
     "t": "背后还要靠一个戴着VR眼镜的"
    },
    {
     "t": "真人",
     "c": "gold"
    },
    {
     "t": "，"
    }
   ]
  },
  {
   "start": 173.629,
   "end": 175.561,
   "segs": [
    {
     "t": "在远处替它操作。"
    }
   ]
  },
  {
   "start": 176.471,
   "end": 181.011,
   "segs": [
    {
     "t": "还记得那只替AlphaGo拿棋子的"
    },
    {
     "t": "手",
     "c": "gold"
    },
    {
     "t": "吗？"
    }
   ]
  },
  {
   "start": 181.521,
   "end": 183.52,
   "segs": [
    {
     "t": "它能放下一颗棋子，"
    }
   ]
  },
  {
   "start": 183.48,
   "end": 188.361,
   "segs": [
    {
     "t": "也能洗碗、拧开瓶盖、接住一只快掉下去的杯子。"
    }
   ]
  },
  {
   "start": 188.371,
   "end": 190.955,
   "segs": [
    {
     "t": "它从来"
    },
    {
     "t": "不需要一张棋盘",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 191.765,
   "end": 195.438,
   "segs": [
    {
     "t": "过去六十年，是"
    },
    {
     "t": "我们在迁就机器人",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 195.898,
   "end": 199.572,
   "segs": [
    {
     "t": "接下来，轮到"
    },
    {
     "t": "机器人来迁就我们",
     "c": "gold"
    },
    {
     "t": "了。"
    }
   ]
  }
