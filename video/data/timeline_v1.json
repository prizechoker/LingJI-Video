 "subtitles": [
  {
   "start": 0.3,
   "end": 4.735,
   "segs": [
    {
     "t": "能赢下围棋世界冠军的AI，却"
    },
    {
     "t": "拿不起一颗棋子",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 5.29,
   "end": 8.56,
   "segs": [
    {
     "t": "2016年，AlphaGo战胜李世石。"
    }
   ]
  },
  {
   "start": 9.15,
   "end": 10.65,
   "segs": [
    {
     "t": "很少有人注意到："
    }
   ]
  },
  {
   "start": 10.61,
   "end": 11.96,
   "segs": [
    {
     "t": "它的每一步棋，"
    }
   ]
  },
  {
   "start": 11.93,
   "end": 14.915,
   "segs": [
    {
     "t": "都是一位"
    },
    {
     "t": "工程师替它放到棋盘上",
     "c": "gold"
    },
    {
     "t": "的。"
    }
   ]
  },
  {
   "start": 15.319,
   "end": 16.649,
   "segs": [
    {
     "t": "十年后的今天，"
    }
   ]
  },
  {
   "start": 16.919,
   "end": 19.789,
   "segs": [
    {
     "t": "机器人已经能"
    },
    {
     "t": "翻跟头、跑半马",
     "c": "cyan"
    },
    {
     "t": "了。"
    }
   ]
  },
  {
   "start": 19.919,
   "end": 22.754,
   "segs": [
    {
     "t": "可它，还是"
    },
    {
     "t": "洗不好你家的碗",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 23.007,
   "end": 23.832,
   "segs": [
    {
     "t": "为什么？"
    }
   ]
  },
  {
   "start": 26.419,
   "end": 30.609,
   "segs": [
    {
     "t": "1979年，斯坦福有一辆装着摄像头的小车，"
    }
   ]
  },
  {
   "start": 30.759,
   "end": 33.234,
   "segs": [
    {
     "t": "要穿过一个摆满椅子的房间。"
    }
   ]
  },
  {
   "start": 33.439,
   "end": 34.844,
   "segs": [
    {
     "t": "它花了"
    },
    {
     "t": "五个小时",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 34.974,
   "end": 37.344,
   "segs": [
    {
     "t": "每走一米，就停下来拍照，"
    }
   ]
  },
  {
   "start": 37.514,
   "end": 39.069,
   "segs": [
    {
     "t": "再想十几分钟。"
    }
   ]
  },
  {
   "start": 39.92,
   "end": 42.93,
   "segs": [
    {
     "t": "带它上路的博士生叫莫拉维克。"
    }
   ]
  },
  {
   "start": 43.14,
   "end": 46.25,
   "segs": [
    {
     "t": "他后来总结：让电脑下棋并不难；"
    }
   ]
  },
  {
   "start": 46.36,
   "end": 48.32,
   "segs": [
    {
     "t": "难的是像"
    },
    {
     "t": "一岁小孩",
     "c": "cyan"
    },
    {
     "t": "那样，"
    }
   ]
  },
  {
   "start": 48.28,
   "end": 51.635,
   "segs": [
    {
     "t": "看一眼，走两步，伸手拿个东西",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 52.223,
   "end": 53.353,
   "segs": [
    {
     "t": "可既然这么难，"
    }
   ]
  },
  {
   "start": 53.443,
   "end": 57.018,
   "segs": [
    {
     "t": "工厂里的机器人，又是怎么干了"
    },
    {
     "t": "六十多年",
     "c": "gold"
    },
    {
     "t": "活的？"
    }
   ]
  },
  {
   "start": 57.306,
   "end": 61.816,
   "segs": [
    {
     "t": "1961年，第一台工业机器人在美国通用汽车上岗。"
    }
   ]
  },
  {
   "start": 61.896,
   "end": 64.681,
   "segs": [
    {
     "t": "它"
    },
    {
     "t": "没有眼睛",
     "c": "gold"
    },
    {
     "t": "，什么也看不见。"
    }
   ]
  },
  {
   "start": 64.888,
   "end": 66.918,
   "segs": [
    {
     "t": "但工厂替它安排好了一切："
    }
   ]
  },
  {
   "start": 67.208,
   "end": 69.298,
   "segs": [
    {
     "t": "每个零件，每一次，"
    }
   ]
  },
  {
   "start": 69.488,
   "end": 71.353,
   "segs": [
    {
     "t": "都出现在"
    },
    {
     "t": "同一个位置",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 71.478,
   "end": 72.483,
   "segs": [
    {
     "t": "它不用看。"
    }
   ]
  },
  {
   "start": 73.013,
   "end": 76.808,
   "segs": [
    {
     "t": "因为它面前的世界，已经被摆成了"
    },
    {
     "t": "一张棋盘",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 77.429,
   "end": 80.434,
   "segs": [
    {
     "t": "后来的成功，几乎都靠这一招。"
    }
   ]
  },
  {
   "start": 80.574,
   "end": 82.264,
   "segs": [
    {
     "t": "仓库机器人不认路？"
    }
   ]
  },
  {
   "start": 82.574,
   "end": 86.189,
   "segs": [
    {
     "t": "那就在地上"
    },
    {
     "t": "贴满二维码",
     "c": "gold"
    },
    {
     "t": "，让它在格子里走。"
    }
   ]
  },
  {
   "start": 86.288,
   "end": 88.318,
   "segs": [
    {
     "t": "扫地机器人干不了家务？"
    }
   ]
  },
  {
   "start": 88.548,
   "end": 91.223,
   "segs": [
    {
     "t": "那就只交给它一件事："
    },
    {
     "t": "地板",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 91.355,
   "end": 94.785,
   "segs": [
    {
     "t": "就连洗碗，我们也没造一个会洗碗的“人”，"
    }
   ]
  },
  {
   "start": 94.895,
   "end": 96.505,
   "segs": [
    {
     "t": "而是造了个"
    },
    {
     "t": "盒子",
     "c": "gold"
    },
    {
     "t": "："
    }
   ]
  },
  {
   "start": 96.955,
   "end": 100.42,
   "segs": [
    {
     "t": "碗插进格子，关门，喷水。"
    }
   ]
  },
  {
   "start": 100.99,
   "end": 103.81,
   "segs": [
    {
     "t": "所以，机器人六十多年的成功，"
    }
   ]
  },
  {
   "start": 103.77,
   "end": 106.06,
   "segs": [
    {
     "t": "靠的大多不是机器变聪明，"
    }
   ]
  },
  {
   "start": 106.17,
   "end": 109.285,
   "segs": [
    {
     "t": "而是"
    },
    {
     "t": "我们把世界，变简单了",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 110.01,
   "end": 113.475,
   "segs": [
    {
     "t": "可有一个地方，变不成棋盘——"
    },
    {
     "t": "你家",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 113.833,
   "end": 117.223,
   "segs": [
    {
     "t": "碗的形状各不一样，衣服随手一扔，"
    }
   ]
  },
  {
   "start": 117.273,
   "end": 118.943,
   "segs": [
    {
     "t": "猫还会跳上桌子。"
    }
   ]
  },
  {
   "start": 118.973,
   "end": 120.578,
   "segs": [
    {
     "t": "每一天，都不一样",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 120.913,
   "end": 124.443,
   "segs": [
    {
     "t": "于是，越来越多的人押注另一条路："
    }
   ]
  },
  {
   "start": 124.753,
   "end": 127.788,
   "segs": [
    {
     "t": "改不了世界，那就"
    },
    {
     "t": "改机器人",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 127.986,
   "end": 131.656,
   "segs": [
    {
     "t": "我们的世界，本来就是照着"
    },
    {
     "t": "人的身体",
     "c": "gold"
    },
    {
     "t": "设计的："
    }
   ]
  },
  {
   "start": 131.746,
   "end": 134.456,
   "segs": [
    {
     "t": "门把手、楼梯、锅铲。"
    }
   ]
  },
  {
   "start": 135.166,
   "end": 138.461,
   "segs": [
    {
     "t": "那干脆，把机器人也造成人的样子。"
    }
   ]
  },
  {
   "start": 138.669,
   "end": 141.759,
   "segs": [
    {
     "t": "你看，人形机器人上了春晚，"
    }
   ]
  },
  {
   "start": 141.849,
   "end": 145.384,
   "segs": [
    {
     "t": "还在半马比赛里，"
    },
    {
     "t": "跑赢了人类的世界纪录",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 145.849,
   "end": 149.199,
   "segs": [
    {
     "t": "可在赛道上把同一个动作重复几万次，"
    }
   ]
  },
  {
   "start": 149.429,
   "end": 151.989,
   "segs": [
    {
     "t": "和面对一摞每次都不一样的碗，"
    }
   ]
  },
  {
   "start": 151.949,
   "end": 153.334,
   "segs": [
    {
     "t": "是两回事",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 153.703,
   "end": 157.073,
   "segs": [
    {
     "t": "今天，有的家务机器人碰到复杂的活儿，"
    }
   ]
  },
  {
   "start": 157.143,
   "end": 159.913,
   "segs": [
    {
     "t": "背后还要靠一个戴着VR眼镜的"
