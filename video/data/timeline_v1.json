  {
   "start": 171.89,
   "end": 173.935,
   "segs": [
    {
     "t": "它从来"
    },
    {
     "t": "不需要一张棋盘",
     "c": "gold"
    },
    {
     "t": "。"
    }
   ]
  },
  {
   "start": 174.695,
   "end": 177.75,
   "segs": [
    {
     "t": "过去六十年，是"
